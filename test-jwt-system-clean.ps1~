# JWT & Refresh Token System Test Script
# This script tests the complete JWT and rotating refresh token implementation

param(
    [string]$BaseUrl = "http://localhost:8080",
    [string]$Username = "testuser123",
    [string]$Password = "password123"
)

Write-Host "=======================================" -ForegroundColor Cyan
Write-Host "   JWT & Refresh Token System Test" -ForegroundColor Cyan
Write-Host "=======================================" -ForegroundColor Cyan
Write-Host ""

$testsPassed = 0
$testsFailed = 0

# Test 1: Server Status
Write-Host "Test 1: Checking server status..." -ForegroundColor Yellow
try {
    $status = Invoke-WebRequest -Uri "$BaseUrl/api/status" -Method GET -ErrorAction Stop -TimeoutSec 5
    Write-Host "[PASS] Server is running (Status: $($status.StatusCode))" -ForegroundColor Green
    $testsPassed++
} catch {
    Write-Host "[FAIL] Server is not running!" -ForegroundColor Red
    Write-Host "   Start the server with: mvnw spring-boot:run" -ForegroundColor Yellow
    $testsFailed++
    exit 1
}
Write-Host ""

# Test 2: Login and get tokens
Write-Host "Test 2: Login and retrieve tokens..." -ForegroundColor Yellow
$loginBody = @{
    user_name = $Username
    password = $Password
} | ConvertTo-Json

try {
    $loginResponse = Invoke-RestMethod -Uri "$BaseUrl/user/login" -Method POST -Body $loginBody -ContentType "application/json" -ErrorAction Stop

    if ($loginResponse.success -eq $true -and $loginResponse.access_token -and $loginResponse.refresh_token) {
        Write-Host "[PASS] Login successful!" -ForegroundColor Green
        $tokenPreview = $loginResponse.access_token.Substring(0, [Math]::Min(30, $loginResponse.access_token.Length))
        Write-Host "   Access Token: $tokenPreview..." -ForegroundColor Gray
        Write-Host "   Refresh Token: $($loginResponse.refresh_token)" -ForegroundColor Gray
        Write-Host "   Token Type: $($loginResponse.token_type)" -ForegroundColor Gray
        Write-Host "   Expires In: $($loginResponse.expires_in) seconds" -ForegroundColor Gray

        $accessToken = $loginResponse.access_token
        $refreshToken = $loginResponse.refresh_token

        # Verify token format
        if ($loginResponse.expires_in -eq 900) {
            Write-Host "   Token expiration is correct (15 minutes)" -ForegroundColor Gray
        } else {
            Write-Host "   Warning: Token expiration is $($loginResponse.expires_in) seconds instead of 900" -ForegroundColor Yellow
        }

        $testsPassed++
    } else {
        Write-Host "[FAIL] Login failed - $($loginResponse.message)" -ForegroundColor Red
        $testsFailed++
        exit 1
    }
} catch {
    Write-Host "[FAIL] Login error" -ForegroundColor Red
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Red
    if ($_.ErrorDetails.Message) {
        try {
            $errorObj = $_.ErrorDetails.Message | ConvertFrom-Json
            Write-Host "   Details: $($errorObj.message)" -ForegroundColor Red
        } catch {}
    }
    $testsFailed++
    exit 1
}
Write-Host ""

# Test 3: Use access token on protected endpoint
Write-Host "Test 3: Testing access token authentication..." -ForegroundColor Yellow
$headers = @{
    "Authorization" = "Bearer $accessToken"
}

try {
    $protectedResponse = Invoke-RestMethod -Uri "$BaseUrl/jwt-try" -Method GET -Headers $headers -ErrorAction Stop

    if ($protectedResponse.success -eq $true) {
        Write-Host "[PASS] Access token authenticated successfully!" -ForegroundColor Green
        Write-Host "   Response: $($protectedResponse.message)" -ForegroundColor Gray
        $testsPassed++
    } else {
        Write-Host "[FAIL] Access token authentication failed" -ForegroundColor Red
        $testsFailed++
    }
} catch {
    Write-Host "[FAIL] Access token doesn't work" -ForegroundColor Red
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Red
    $testsFailed++
}
Write-Host ""

# Test 4: Refresh token (Token Rotation)
Write-Host "Test 4: Testing token refresh (rotation)..." -ForegroundColor Yellow
$refreshBody = @{
    refresh_token = $refreshToken
} | ConvertTo-Json

try {
    $refreshResponse = Invoke-RestMethod -Uri "$BaseUrl/user/refresh" -Method POST -Body $refreshBody -ContentType "application/json" -ErrorAction Stop

    if ($refreshResponse.success -eq $true -and $refreshResponse.access_token -and $refreshResponse.refresh_token) {
        $rotationWorked = $refreshResponse.refresh_token -ne $refreshToken

        if ($rotationWorked) {
            Write-Host "[PASS] Token refresh and rotation successful!" -ForegroundColor Green
            $newTokenPreview = $refreshResponse.access_token.Substring(0, [Math]::Min(30, $refreshResponse.access_token.Length))
            Write-Host "   New Access Token: $newTokenPreview..." -ForegroundColor Gray
            Write-Host "   New Refresh Token: $($refreshResponse.refresh_token)" -ForegroundColor Gray
            Write-Host "   Old Refresh Token: $refreshToken" -ForegroundColor Gray
            Write-Host "   Token Rotation: YES (tokens are different)" -ForegroundColor Green
            $testsPassed++
        } else {
            Write-Host "[FAIL] Token rotation NOT working (same token returned)" -ForegroundColor Red
            $testsFailed++
        }

        $newAccessToken = $refreshResponse.access_token
        $newRefreshToken = $refreshResponse.refresh_token
        $oldRefreshToken = $refreshToken
    } else {
        Write-Host "[FAIL] Token refresh failed" -ForegroundColor Red
        $testsFailed++
    }
} catch {
    Write-Host "[FAIL] Token refresh error" -ForegroundColor Red
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Red
    $testsFailed++
}
Write-Host ""

# Test 5: Token reuse detection (Security Feature)
Write-Host "Test 5: Testing token reuse detection (security)..." -ForegroundColor Yellow
$reuseBody = @{
    refresh_token = $oldRefreshToken
} | ConvertTo-Json

try {
    $reuseResponse = Invoke-RestMethod -Uri "$BaseUrl/user/refresh" -Method POST -Body $reuseBody -ContentType "application/json" -ErrorAction Stop
    Write-Host "[FAIL] Token reuse was NOT detected! Security vulnerability!" -ForegroundColor Red
    Write-Host "   Old token should have been rejected" -ForegroundColor Red
    $testsFailed++
} catch {
    if ($_.Exception.Response.StatusCode.value__ -eq 401) {
        Write-Host "[PASS] Token reuse detected and blocked!" -ForegroundColor Green

        try {
            $errorResponse = $_.ErrorDetails.Message | ConvertFrom-Json
            Write-Host "   Security Message: $($errorResponse.message)" -ForegroundColor Gray
        } catch {
            Write-Host "   Token correctly rejected with 401 Unauthorized" -ForegroundColor Gray
        }

        $testsPassed++
    } else {
        Write-Host "[FAIL] Unexpected error during token reuse test" -ForegroundColor Red
        $testsFailed++
    }
}
Write-Host ""

# Test 6: Logout (Token Revocation)
Write-Host "Test 6: Testing logout (token revocation)..." -ForegroundColor Yellow
$logoutBody = @{
    refresh_token = $newRefreshToken
} | ConvertTo-Json

try {
    $logoutResponse = Invoke-RestMethod -Uri "$BaseUrl/user/logout" -Method POST -Body $logoutBody -ContentType "application/json" -ErrorAction Stop

    if ($logoutResponse.success -eq $true) {
        Write-Host "[PASS] Logout successful!" -ForegroundColor Green
        Write-Host "   Message: $($logoutResponse.message)" -ForegroundColor Gray
        $testsPassed++
    } else {
        Write-Host "[FAIL] Logout failed" -ForegroundColor Red
        $testsFailed++
    }
} catch {
    Write-Host "[FAIL] Logout error" -ForegroundColor Red
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Red
    $testsFailed++
}
Write-Host ""

# Test 7: Verify logged out token cannot be used
Write-Host "Test 7: Verifying logged out token is revoked..." -ForegroundColor Yellow
$verifyBody = @{
    refresh_token = $newRefreshToken
} | ConvertTo-Json

try {
    $verifyResponse = Invoke-RestMethod -Uri "$BaseUrl/user/refresh" -Method POST -Body $verifyBody -ContentType "application/json" -ErrorAction Stop
    Write-Host "[FAIL] Logged out token still works! Revocation not working!" -ForegroundColor Red
    $testsFailed++
} catch {
    if ($_.Exception.Response.StatusCode.value__ -eq 401) {
        Write-Host "[PASS] Logged out token correctly rejected!" -ForegroundColor Green
        Write-Host "   Token revocation is working properly" -ForegroundColor Gray
        $testsPassed++
    } else {
        Write-Host "[FAIL] Unexpected error" -ForegroundColor Red
        $testsFailed++
    }
}
Write-Host ""

# Summary
Write-Host "=======================================" -ForegroundColor Cyan
Write-Host "           TEST SUMMARY" -ForegroundColor Cyan
Write-Host "=======================================" -ForegroundColor Cyan
Write-Host "Tests Passed: $testsPassed" -ForegroundColor Green
$failColor = if ($testsFailed -eq 0) { "Green" } else { "Red" }
Write-Host "Tests Failed: $testsFailed" -ForegroundColor $failColor
$totalTests = $testsPassed + $testsFailed
Write-Host "Total Tests:  $totalTests" -ForegroundColor Cyan
Write-Host ""

if ($testsFailed -eq 0) {
    Write-Host "ALL TESTS PASSED!" -ForegroundColor Green
    Write-Host "Your JWT and Refresh Token system is working correctly!" -ForegroundColor Green
    Write-Host ""
    Write-Host "Login returns both tokens" -ForegroundColor Gray
    Write-Host "Access token authenticates requests" -ForegroundColor Gray
    Write-Host "Token refresh returns new tokens (rotation)" -ForegroundColor Gray
    Write-Host "Token reuse is detected and blocked" -ForegroundColor Gray
    Write-Host "Logout revokes tokens" -ForegroundColor Gray
    Write-Host "Revoked tokens cannot be reused" -ForegroundColor Gray
    exit 0
} else {
    Write-Host "SOME TESTS FAILED" -ForegroundColor Yellow
    Write-Host "Please check the failures above and review:" -ForegroundColor Yellow
    Write-Host "  - Server logs for errors" -ForegroundColor Gray
    Write-Host "  - Database refresh_tokens table" -ForegroundColor Gray
    Write-Host "  - Configuration in application.yml" -ForegroundColor Gray
    exit 1
}

