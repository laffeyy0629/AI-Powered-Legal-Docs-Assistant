# JWT Configuration - Backend Environment Variables
# This file should be in: ai-docs-assistant/.env

# JWT Secret Key (REQUIRED)
# Generate a secure key: openssl rand -base64 32
# Or use PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET_KEY=

# JWT Token Expiration (milliseconds)
# Default: 86400000 = 24 hours
# 1 hour = 3600000, 7 days = 604800000
JWT_EXPIRATION_MS=86400000

# OAuth2 Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (REQUIRED for email verification)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# Enable 2FA first, then generate app password for "Mail"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=AI Docs Assistant

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:5173

# AI API Configuration
AI_API_KEY=

