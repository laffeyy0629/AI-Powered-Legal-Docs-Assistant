# PUT THE .ENV FILE INSIDE THE ai-docs-assistant/ DIRECTORY
# JWT Configuration - Backend Environment Variables
# This file should be in: ai-docs-assistant/.env

# JWT Secret Key (REQUIRED)
# Generate a secure key: openssl rand -base64 32
# Or use PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET_KEY=UK9EWlLgnGNxHDaYs571CIvdPeZOMwp8ijJAtRyk

# JWT Access Token Expiration (milliseconds)
# Industry standard: 900000 = 15 minutes (recommended for security)
# Alternative options: 300000 = 5 min, 1800000 = 30 min, 3600000 = 1 hour
JWT_EXPIRATION_MS=900000

# JWT Refresh Token Expiration (days)
# Industry standard: 7 days (already configured in application.yml)
# JWT_REFRESH_EXPIRATION_DAYS=7

# OAuth2 Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (REQUIRED for email verification)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# Enable 2FA first, then generate app password for "Mail"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME=AI Docs Assistant

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:5173


